# local safety-net excludes (large/generated)
backend/vendor
backend/node_modules
smarterp.sql
*.tar.gz

# Build artifacts copied into the Laravel public dir at deploy time
# (regenerated by `npm run build` + the deploy scripts — not source-controlled)
backend/public/assets
backend/public/index.html
backend/public/favicon.ico
backend/public/robots.txt

# Contains real production DB credentials — never commit
backend/.env.production.deploy
.env.production

# Local env files (frontend needs none; backend keeps its own .env)
.env

# Laravel's generated package/service manifests
backend/bootstrap/cache/*.php

# PHPUnit cache
.phpunit.result.cache
