# Prefer the static SPA index.html over Laravel's index.php for bare
# directory requests (e.g. https://erp.irlbd.com/) — otherwise Apache's
# default DirectoryIndex order serves Laravel's own (separately-deployed,
# easily stale) public/index.html for "/" while every other route below
# correctly serves the freshly-built static index.html.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonicalize on the licensed domain — acc.irlbd.com and erp.irlbd.com
    # share this document root, but the software license is bound to
    # erp.irlbd.com specifically, so send any traffic on the old domain
    # there permanently.
    RewriteCond %{HTTP_HOST} ^acc\.irlbd\.com$ [NC]
    RewriteRule ^(.*)$ https://erp.irlbd.com/$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller (Laravel)
    # API routes go to Laravel
    RewriteCond %{REQUEST_URI} ^/api
    RewriteRule ^ index.php [L]

    # Serve static assets directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # All other routes go to React SPA (index.html)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# Allow large SQL backup uploads for /api/v1/backups/restore
<IfModule mod_php.c>
    php_value upload_max_filesize 5120M
    php_value post_max_size       5120M
    php_value max_input_time      -1
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 5120M
    php_value post_max_size       5120M
    php_value max_input_time      -1
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 5120M
    php_value post_max_size       5120M
    php_value max_input_time      -1
</IfModule>

# Security: deny access to sensitive files
<FilesMatch "\.(env|sql|md|json|lock|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# index.html must never be cached — it's the only thing that references the
# current content-hashed JS/CSS bundle filenames, so a stale cached copy of
# just this one file is what makes a browser keep running old app code
# after a deploy even though the new bundle itself is already live.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
