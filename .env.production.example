# ===== SmartERP — Production Frontend Env =====
# Copy to ".env.production" before `npm run build`.
# Domain: erp.irlbd.com  |  VPS: 163.227.239.159  |  App root: /opt/smarterp

VITE_SUPABASE_URL="https://erp.irlbd.com/supabase-disabled"
VITE_SUPABASE_PUBLISHABLE_KEY="vps-laravel-mode-no-supabase"
VITE_SUPABASE_PROJECT_ID="vps-laravel"

# Laravel API base (same domain, served by Nginx). When this is set,
# the frontend disables Supabase Auth auto-refresh and uses Laravel token auth.
VITE_API_BASE_URL="https://erp.irlbd.com/api"
